{
  "gdpr_compliance": "relax",
  "entrypoint": "accueil",
  "variables": {
    "title": "Speechbrain",
    "authors": "Cédric Fayet, Titiplex"
  },
  "admin": {
    "entrypoint": {
      "mod": "admin_panel",
      "password": "bflzefinlh67s",
      "variables": {
        "subtitle": "Admin Panel"
      }
    },
    "mods": [
      {
        "mod": "export_bdd",
        "variables": {
          "subtitle": "Download BDD",
          "subdescription": "Download the database in CSV or SQLite format."
        }
      },
      {
        "mod": "stats",
        "variables": {
          "subtitle": "Résultats",
          "subdescription": "Statistiques des évaluations perceptives."
        },
        "reports": {
          "integration": {
            "title": "Qualité de l’intégration",
            "template": "results.tpl",
            "sources": {
              "sys1": {
                "table": "TestSample_evaluation_mos",
                "column": "MOS_score_sys1",
                "compare": [
                  "MOS_score_sys1",
                  "MOS_score_sys2"
                ]
              },
              "sys2": {
                "table": "TestSample_evaluation_mos",
                "column": "MOS_score_sys2"
              }
            }
          },
          "controles": {
            "title": "Contrôles d’attention",
            "description": "Réponses aux consignes, séparées des résultats principaux.",
            "template": "controls.tpl",
            "sources": {
              "Compréhension": {
                "type": "control",
                "table": "Form_comprehension",
                "exclude_intro": false,
                "expected": {
                  "criterion": "raccord"
                }
              },
              "AB": {
                "type": "control",
                "table": "TestSample_evaluation_ab",
                "exclude_intro": false,
                "expected": {
                  "protocol_correct": "1"
                },
                "role": "control"
              },
              "MOS": {
                "type": "control",
                "table": "TestSample_evaluation_mos",
                "exclude_intro": false,
                "expected": {
                  "protocol_correct": "1"
                },
                "role": "control"
              },
              "ABX": {
                "type": "control",
                "table": "TestSample_evaluation_abx",
                "exclude_intro": false,
                "expected": {
                  "protocol_correct": "1"
                },
                "role": "control"
              },
              "Casque (optionnel)": {
                "type": "control",
                "table": "TestSample_headphones",
                "exclude_intro": false,
                "expected": {
                  "protocol_correct": "1"
                }
              }
            }
          },
          "preferences": {
            "title": "Préférences A/B",
            "template": "categories.tpl",
            "sources": {
              "Résultats": {
                "type": "ab",
                "table": "TestSample_evaluation_ab"
              }
            }
          },
          "identification": {
            "title": "Identification ABX",
            "template": "categories.tpl",
            "sources": {
              "Résultats": {
                "type": "abx",
                "table": "TestSample_evaluation_abx"
              }
            }
          },
          "qualite": {
            "title": "Stabilité et positions",
            "template": "quality.tpl",
            "sources": {
              "AB": {
                "type": "quality",
                "protocol": "ab",
                "table": "TestSample_evaluation_ab",
                "exclude_intro": false
              },
              "MOS": {
                "type": "quality",
                "protocol": "mos",
                "table": "TestSample_evaluation_mos",
                "exclude_intro": false
              },
              "ABX": {
                "type": "quality",
                "protocol": "abx",
                "table": "TestSample_evaluation_abx",
                "exclude_intro": false
              }
            }
          },
          "historique": {
            "title": "Ancien MOS (historique)",
            "template": "results.tpl",
            "sources": {
              "sys1": {
                "table": "TestSample_test_mos",
                "column": "MOS_score_sys1"
              },
              "sys2": {
                "table": "TestSample_test_mos",
                "column": "MOS_score_sys2"
              }
            }
          },
          "conditions": {
            "title": "Conditions et compréhension",
            "template": "profile.tpl",
            "sources": {
              "listening_conditions": {
                "type": "profile",
                "table": "Form_listening_conditions",
                "exclude_intro": false
              },
              "comprehension": {
                "type": "profile",
                "table": "Form_comprehension",
                "exclude_intro": false
              }
            }
          }
        }
      }
    ]
  },
  "stages": {
    "accueil": {
      "type": "page:user",
      "template": "welcome.tpl",
      "next": "listening_conditions"
    },
    "test_ab": {
      "type": "test",
      "template": "ab.tpl",
      "next": "controle_ab",
      "nb_steps": 1,
      "nb_step_intro": 0,
      "transaction_timeout_seconds": 600,
      "variables": {
        "subtitle": "Test AB"
      }
    },
    "test_mos": {
      "type": "test",
      "template": "mos.tpl",
      "next": "controle_mos",
      "nb_steps": 1,
      "nb_step_intro": 0,
      "transaction_timeout_seconds": 600,
      "variables": {
        "subtitle": "Test MOS"
      }
    },
    "test_abx": {
      "type": "test",
      "template": "abx.tpl",
      "next": "fin_du_test",
      "nb_steps": 1,
      "nb_step_intro": 0,
      "transaction_timeout_seconds": 600,
      "variables": {
        "subtitle": "Test ABX"
      }
    },
    "fin_du_test": {
      "type": "page:user",
      "template": "end.tpl"
    },
    "entrainement_ab": {
      "type": "test",
      "template": "ab.tpl",
      "nb_steps": 1,
      "nb_step_intro": 1,
      "next": "test_ab",
      "variables": {
        "subtitle": "Entraînement AB"
      }
    },
    "entrainement_mos": {
      "type": "test",
      "template": "mos.tpl",
      "nb_steps": 1,
      "nb_step_intro": 1,
      "next": "test_mos",
      "variables": {
        "subtitle": "Entraînement MOS"
      }
    },
    "entrainement_abx": {
      "type": "test",
      "template": "abx.tpl",
      "nb_steps": 1,
      "nb_step_intro": 1,
      "next": "test_abx",
      "variables": {
        "subtitle": "Entraînement ABX"
      }
    },
    "controle_ab": {
      "type": "test",
      "template": "controle_ab.tpl",
      "nb_steps": 1,
      "nb_step_intro": 0,
      "next": "entrainement_mos",
      "variables": {
        "subtitle": "Vérification de la consigne"
      }
    },
    "controle_mos": {
      "type": "test",
      "template": "controle_mos.tpl",
      "nb_steps": 1,
      "nb_step_intro": 0,
      "next": "entrainement_abx",
      "variables": {
        "subtitle": "Vérification de la consigne"
      }
    },
    "listening_conditions": {
      "type": "form",
      "template": "listening_conditions.tpl",
      "next": "comprehension"
    },
    "comprehension": {
      "type": "form",
      "template": "comprehension.tpl",
      "next": "formation_ab"
    },
    "formation_ab": {
      "type": "test",
      "template": "ab_experience.tpl",
      "nb_steps": 5,
      "nb_step_intro": 5,
      "next": "evaluation_ab",
      "variables": {
        "subtitle": "Entraînement AB",
        "question": "Dans quelle version le nom s’intègre-t-il le plus naturellement à la phrase ?"
      }
    },
    "evaluation_ab": {
      "type": "test",
      "template": "ab_experience.tpl",
      "nb_steps": 9,
      "nb_step_intro": 0,
      "next": "formation_mos",
      "variables": {
        "subtitle": "Évaluation AB",
        "question": "Dans quelle version le nom s’intègre-t-il le plus naturellement à la phrase ?",
        "allow_tie": true
      }
    },
    "formation_mos": {
      "type": "test",
      "template": "mos_experience.tpl",
      "nb_steps": 5,
      "nb_step_intro": 5,
      "next": "evaluation_mos",
      "variables": {
        "subtitle": "Entraînement MOS",
        "question": "À quel point le nom s’intègre-t-il naturellement au reste de la phrase ?",
        "label_1": "Très mal",
        "label_2": "Mal",
        "label_3": "Moyennement",
        "label_4": "Bien",
        "label_5": "Très bien"
      }
    },
    "evaluation_mos": {
      "type": "test",
      "template": "mos_experience.tpl",
      "nb_steps": 9,
      "nb_step_intro": 0,
      "next": "formation_abx",
      "variables": {
        "subtitle": "Évaluation MOS",
        "question": "À quel point le nom s’intègre-t-il naturellement au reste de la phrase ?",
        "allow_tie": false,
        "label_1": "Très mal",
        "label_2": "Mal",
        "label_3": "Moyennement",
        "label_4": "Bien",
        "label_5": "Très bien"
      }
    },
    "formation_abx": {
      "type": "test",
      "template": "abx_experience.tpl",
      "nb_steps": 5,
      "nb_step_intro": 5,
      "next": "evaluation_abx",
      "variables": {
        "subtitle": "Entraînement ABX",
        "question": "X correspond-il à A ou à B ?"
      }
    },
    "evaluation_abx": {
      "type": "test",
      "template": "abx_experience.tpl",
      "nb_steps": 9,
      "nb_step_intro": 0,
      "next": "fin_du_test",
      "variables": {
        "subtitle": "Évaluation ABX",
        "question": "X correspond-il à A ou à B ?",
        "allow_tie": false
      }
    },
    "headphones": {
      "type": "test",
      "template": "headphones.tpl",
      "nb_steps": 6,
      "nb_step_intro": 0,
      "next": "comprehension",
      "variables": {
        "subtitle": "Vérification du casque",
        "question": "Quel extrait est le moins fort ?"
      }
    }
  }
}
