{
  "gdpr_compliance": "relax",
  "entrypoint": "accueil",
  "variables": {
    "title": "Speechbrain",
    "authors": "Cédric Fayet, Titiplex"
  },
  "admin": {
    "entrypoint": {
      "mod": "admin_panel",
      "password": "bflzefinlh67s",
      "variables": {
        "subtitle": "Admin Panel"
      }
    },
    "mods": [
      {
        "mod": "export_bdd",
        "variables": {
          "subtitle": "Download BDD",
          "subdescription": "Download the database in CSV or SQLite format."
        }
      },
      {
        "mod": "stats",
        "variables": {
          "subtitle": "Résultats",
          "subdescription": "Statistiques des évaluations perceptives."
        },
        "reports": {
          "integration": {
            "title": "Qualité de l’intégration",
            "template": "integration.tpl",
            "sources": {
              "method_a": {
                "table": "TestSample_test_mos",
                "column": "MOS_score_sys1",
                "exclude_intro": true
              },
              "method_b": {
                "table": "TestSample_test_mos",
                "column": "MOS_score_sys2",
                "exclude_intro": true
              }
            }
          },
          "naturalness": {
            "title": "La qualité au naturel",
            "template": "naturalness.tpl",
            "sources": {
              "method_a": {
                "table": "TestSample_test_mos",
                "column": "MOS_score_sys1",
                "exclude_intro": true
              },
              "method_b": {
                "table": "TestSample_test_mos",
                "column": "MOS_score_sys2",
                "exclude_intro": true
              }
            }
          },
          "controles": {
            "title": "Contrôles d’attention",
            "description": "Réponses aux consignes, séparées des résultats principaux.",
            "template": "controls.tpl",
            "sources": {
              "Consigne A/B": {
                "type": "control",
                "table": "TestSample_controle_ab",
                "exclude_intro": false,
                "expected": {
                  "ChoiceBetween_sys1_sys2": "sys1"
                }
              },
              "Consigne MOS": {
                "type": "control",
                "table": "TestSample_controle_mos",
                "exclude_intro": false,
                "expected": {
                  "MOS_score_sys1": "2",
                  "MOS_score_sys2": "2"
                }
              }
            }
          }
        }
      }
    ]
  },
  "stages": {
    "accueil": {
      "type": "page:user",
      "template": "welcome.tpl",
      "next": "entrainement_ab"
    },
    "test_ab": {
      "type": "test",
      "template": "ab.tpl",
      "next": "controle_ab",
      "nb_steps": 1,
      "nb_step_intro": 0,
      "transaction_timeout_seconds": 600,
      "variables": {
        "subtitle": "Test AB"
      }
    },
    "test_mos": {
      "type": "test",
      "template": "mos.tpl",
      "next": "controle_mos",
      "nb_steps": 1,
      "nb_step_intro": 0,
      "transaction_timeout_seconds": 600,
      "variables": {
        "subtitle": "Test MOS"
      }
    },
    "test_abx": {
      "type": "test",
      "template": "abx.tpl",
      "next": "fin_du_test",
      "nb_steps": 1,
      "nb_step_intro": 0,
      "transaction_timeout_seconds": 600,
      "variables": {
        "subtitle": "Test ABX"
      }
    },
    "fin_du_test": {
      "type": "page:user",
      "template": "end.tpl"
    },
    "entrainement_ab": {
      "type": "test",
      "template": "ab.tpl",
      "nb_steps": 1,
      "nb_step_intro": 1,
      "next": "test_ab",
      "variables": {
        "subtitle": "Entraînement AB"
      }
    },
    "entrainement_mos": {
      "type": "test",
      "template": "mos.tpl",
      "nb_steps": 1,
      "nb_step_intro": 1,
      "next": "test_mos",
      "variables": {
        "subtitle": "Entraînement MOS"
      }
    },
    "entrainement_abx": {
      "type": "test",
      "template": "abx.tpl",
      "nb_steps": 1,
      "nb_step_intro": 1,
      "next": "test_abx",
      "variables": {
        "subtitle": "Entraînement ABX"
      }
    },
    "controle_ab": {
      "type": "test",
      "template": "controle_ab.tpl",
      "nb_steps": 1,
      "nb_step_intro": 0,
      "next": "entrainement_mos",
      "variables": {
        "subtitle": "Vérification de la consigne"
      }
    },
    "controle_mos": {
      "type": "test",
      "template": "controle_mos.tpl",
      "nb_steps": 1,
      "nb_step_intro": 0,
      "next": "entrainement_abx",
      "variables": {
        "subtitle": "Vérification de la consigne"
      }
    }
  }
}
